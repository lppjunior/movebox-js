{
  "name": "@movebox/game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "test": "jest --config ../../jest.config.cjs --selectProjects game --runInBand",
